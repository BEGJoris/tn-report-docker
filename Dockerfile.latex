FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-xetex \
    texlive-bibtex-extra \
    texlive-extra-utils \
    latexmk \
    make \
    ca-certificates \
    curl \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /work
VOLUME ["/work"]

# Default entrypoint runs latexmk on the provided .tex file (pass filename as command)
ENTRYPOINT ["latexmk", "-pdf", "-interaction=nonstopmode", "-f"]
